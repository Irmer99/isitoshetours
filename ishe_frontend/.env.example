# Client-side API base URL (baked into the client bundle at build time).
# Local dev:      http://localhost:3000/api
# Docker dev:     /api   (nginx proxies /api to the backend container)
# Render/Droplet: /api   (nginx routes /api to the backend)
VITE_API_URL=http://localhost:3000/api

# SSR server-side backend URL (Node.js runtime only — never exposed to the browser).
# Local/Docker:   http://backend:3000/api   (Docker service name, used automatically)
# Render/Droplet: https://your-backend-url/api  (or http://<ip>/api behind nginx)
# SSR_API_URL=http://backend:3000/api
