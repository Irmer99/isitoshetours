# ── Database ──────────────────────────────────────────────────────────────
# App connections: Supabase uses the pooler (port 6543). TLS is required.
# sslmode=require is honoured by Prisma migrations and the pg driver.
DATABASE_URL=postgresql://user:password@aws-0-eu-west-1.pooler.supabase.co:6543/postgres?sslmode=require
# Prisma migrations: Supabase direct connection (port 5432).
DIRECT_DATABASE_URL=postgresql://user:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=14d

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins (no trailing slashes).
# Docker: CORS_ORIGIN=http://localhost
CORS_ORIGIN=http://localhost:5173,http://localhost
FRONTEND_URL=http://localhost:5173

# ── Admin seed (used by docker-start.sh / npm run seed) ──────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_ROLE=superadmin

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-api-key
SMTP_FROM=Isitoshe Tours <your-verified-sender@yourdomain.com>
